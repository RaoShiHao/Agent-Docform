# Copy this file to `.env` (optional) or export these variables in your shell.
# Values here override / fill `${...}` placeholders in `config/app_agent/*.yaml`.

DOCFORMFLOW_MODEL=deepseek-v3.2
DOCFORMFLOW_API_KEY=your-api-key
DOCFORMFLOW_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Vision / multimodal model (optional; required only when understand_config.is_vision=true)
DOCFORMFLOW_VLLM_MODEL=glm-4.6v
DOCFORMFLOW_VLLM_API_KEY=your-vision-api-key
DOCFORMFLOW_VLLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
